NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
# Optional Elasticsearch API key for secured clusters (sent as Authorization: ApiKey).
ELASTICSEARCH_API_KEY=

# --- Google OAuth (all three required to enable Google login; see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://mailq-deployment-production.up.railway.app/auth/google/callback

# --- Secrets: generate with `openssl rand -hex 32` (>= 32 chars). Never commit real values. ---
SESSION_SECRET=e2d6b6b593662becfadf2b1e12b4141c1ecdf0e9707c48c47efcfe2bd1d4993e
TOKEN_ENCRYPTION_KEY=60b3cc102a65dd4f46c3a5897ad55b5d77f02f93a9fc8965092be3da70ca6c21

# --- Ethereal SMTP. Leave blank in development to auto-create a throwaway account. ---
ETHEREAL_HOST=
ETHEREAL_PORT=
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Worker / throttling ---
WORKER_CONCURRENCY=5
# Global provider minimum interval between ANY two sends (all workers/instances).
MIN_DELAY_MS=2000
# Global and per-sender hourly caps (UTC calendar-hour windows).
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MAX_RECIPIENTS_PER_BATCH=1000
# Worker-crash recovery: a 'processing' email older than this is reclaimed/flagged.
STALE_PROCESSING_MS=300000
SMTP_TIMEOUT_MS=20000
# BullMQ retries failed delivery jobs with exponential backoff. SMTP delivery arrives in Part 3.
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000

# --- Slack OAuth v2 (see README) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# --- Bull Board (/admin/queues); session-authenticated allowlist. Empty disables the dashboard. ---
# Comma-separated Google account email addresses explicitly authorized to monitor queues.
BULL_BOARD_ADMIN_EMAILS=
